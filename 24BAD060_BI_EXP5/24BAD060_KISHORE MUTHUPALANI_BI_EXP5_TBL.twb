      <aliases enabled='yes' />
      <column caption='Sales Clean' datatype='real' name='[Calculation_0705914995654656]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([sales_amount],0)' />
      </column>
      <column caption='Profit Clean' datatype='real' name='[Calculation_0705914995793921]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([profit],0)' />
      </column>
      <column caption='Quantity Clean' datatype='real' name='[Calculation_0705914995847170]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([quantity],0)' />
      </column>
      <column caption='Region Clean' datatype='string' name='[Calculation_0705914995916803]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([region],&quot;Unknown&quot;)' />
      </column>
      <column caption='Profit Margin %' datatype='real' default-format='p0.000%' name='[Calculation_0705914996281349]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([sales_amount])=0 THEN&#13;&#10;&#13;&#10;0&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;(SUM([profit])/SUM([sales_amount]))*100&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Sales Growth %' datatype='real' default-format='p0.000%' name='[Calculation_0705914996613126]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;SUM([sales_amount])-&#13;&#10;LOOKUP(SUM([sales_amount]),-1)&#13;&#10;)&#13;&#10;/&#13;&#10;ABS(LOOKUP(SUM([sales_amount]),-1))&#13;&#10;*100'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='YTD Sales' datatype='real' name='[Calculation_0705914996879367]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([sales_amount]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Selected KPI' datatype='real' name='[Calculation_0705915001950217]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [Parameters].[Parameter 1]&#13;&#10;&#13;&#10;WHEN &quot;Sales&quot; THEN SUM([sales_amount])&#13;&#10;&#13;&#10;WHEN &quot;Profit&quot; THEN SUM([profit])&#13;&#10;&#13;&#10;END' />
      </column>
