      <aliases enabled='yes' />
      <column caption='new cases clean' datatype='integer' name='[Calculation_2223513963339776]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([new_cases],0)' />
      </column>
      <column caption='total cases clean' datatype='integer' name='[Calculation_2223513963446273]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([total_cases],0)' />
      </column>
      <column caption='total deaths clean' datatype='integer' name='[Calculation_2223513963606018]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([total_deaths],0)' />
      </column>
      <column caption='Total Vaccinations Clean' datatype='integer' name='[Calculation_2223513963753475]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IFNULL([total_vaccinations],0)' />
      </column>
      <column caption='Continent Clean' datatype='string' name='[Calculation_2223513963892740]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([continent],&quot;Unknown&quot;)' />
      </column>
      <column caption='location clean' datatype='string' name='[Calculation_2223513963954181]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IFNULL([location],&quot;Unknown&quot;)' />
      </column>
      <column caption='daily case growth rate' datatype='real' name='[Calculation_2223513964191751]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [total_cases] = 0 THEN&#13;&#10;&#13;&#10;0&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;([new_cases]/[total_cases])*100&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Case Fatality Rate' datatype='real' name='[Calculation_2223513964429320]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [total_cases]=0 THEN&#13;&#10;&#13;&#10;0&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;([total_deaths]/[total_cases])*100&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Vaccination Coverage' datatype='real' name='[Calculation_2223513964498953]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [population]=0 THEN&#13;&#10;&#13;&#10;0&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;([people_vaccinated]/[population])*100&#13;&#10;&#13;&#10;END' />
      </column>
